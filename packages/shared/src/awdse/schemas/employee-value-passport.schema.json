{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmployeeValuePassport",
  "type": "object",
  "properties": {
    "passport_id": { "type": "string" },
    "employee_instance_id": { "type": "string" },
    "period": { "type": "string" },
    "tasks_completed": { "type": "number" },
    "roi_status": { "type": "string", "enum": ["POSITIVE", "NEGATIVE", "INCONCLUSIVE", "INSUFFICIENT_DATA"] }
  },
  "required": ["passport_id", "employee_instance_id", "period", "roi_status"]
}
