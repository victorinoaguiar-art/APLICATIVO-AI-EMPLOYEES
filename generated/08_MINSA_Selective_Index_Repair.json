[
  {
    "chunk_id": "CHK-DR-001-01",
    "source_id": "SRC-MINSA-001",
    "document_number": "21-B/92",
    "document_type": "Lei",
    "article_number": "Artigo 1.º",
    "text": "O Sistema Nacional de Saúde tem por objectivo a prestação de cuidados integrados de saúde a toda a população da República de Angola, garantindo o direito à protecção da saúde nos termos da Constituição.",
    "source_sha256": "86f26458a44adcefc9d10de7dabeb4a1f98ef55714b92c17706264e0fcfdf4ea",
    "text_sha256": "414751ed901a03f0b957644f10affd3e7c5d8b444196d0d8451dba1fe8475d3f",
    "vector_id": "VEC-DR-001-01",
    "selective_action": "VECTOR_REUSE_VALIDATED",
    "vector_reuse_allowed": true,
    "namespace": "HEALTHCARE_REPAIRED_LEGAL_IDENTITY_INDEX_v3.0",
    "reconciliation_timestamp": "2026-09-13T14:36:44.587Z"
  },
  {
    "chunk_id": "CHK-DR-002-01",
    "source_id": "SRC-MINSA-002",
    "document_number": "187/18",
    "document_type": "Decreto Presidencial",
    "article_number": "Artigo 4.º",
    "text": "A carreira de enfermagem estrutura-se nas categorias de Enfermeiro Geral, Enfermeiro Especialista e Enfermeiro Chefe, exigindo a titularidade de grau académico ou profissional reconhecido pelo Ministério da Saúde.",
    "source_sha256": "025bedc411dcaf23e3c7bcc158b82529b33d1188ea023412d8ee8eab6f8247a3",
    "text_sha256": "3d5369778f8809b77364c5bf3f0ceedc43974046c6495b5d5a69b478b396d5f0",
    "vector_id": "VEC-DR-002-01",
    "selective_action": "VECTOR_REUSE_VALIDATED",
    "vector_reuse_allowed": true,
    "namespace": "HEALTHCARE_REPAIRED_LEGAL_IDENTITY_INDEX_v3.0",
    "reconciliation_timestamp": "2026-09-13T14:36:44.587Z"
  },
  {
    "chunk_id": "CHK-DR-003-01",
    "source_id": "SRC-MINSA-003",
    "document_number": "151/21",
    "document_type": "Decreto Presidencial",
    "article_number": "Artigo 8.º",
    "text": "O exercício da actividade médica especializada e o funcionamento de estabelecimentos de saúde dependem de licença sanitária válida emitida pelo Ministério da Saúde e de vistoria de conformidade técnica.",
    "source_sha256": "cc2de77d478b0821f54c240c82c813653ac59f0ad702d1e237c7243bedcd2a5d",
    "text_sha256": "89410641b7d8cb1823a2812c7ed1e9a70e0c8815aee2383dc823c9e225d31349",
    "vector_id": "VEC-DR-003-01",
    "selective_action": "VECTOR_REUSE_VALIDATED",
    "vector_reuse_allowed": true,
    "namespace": "HEALTHCARE_REPAIRED_LEGAL_IDENTITY_INDEX_v3.0",
    "reconciliation_timestamp": "2026-09-13T14:36:44.587Z"
  },
  {
    "chunk_id": "CHK-DR-004-01",
    "source_id": "SRC-MINSA-004",
    "document_number": "260/10",
    "document_type": "Decreto Presidencial",
    "article_number": "Artigo 12.º",
    "text": "As unidades hospitalares do Serviço Nacional de Saúde estão sujeitas a inspecção sanitária periódica e a auditoria de qualidade clínica conduzida pelos inspectores credenciados do MINSA.",
    "source_sha256": "484ec78731490da27072e72c4cd9f0021d819de88c6fc2c747c06e947f0f8632",
    "text_sha256": "67d942bd5c36420641f5571284cc45b39f617b0f335b8b99f02fb8d866510ca9",
    "vector_id": "VEC-DR-004-01",
    "selective_action": "RE-EMBED_METADATA_UPDATED",
    "vector_reuse_allowed": true,
    "namespace": "HEALTHCARE_REPAIRED_LEGAL_IDENTITY_INDEX_v3.0",
    "reconciliation_timestamp": "2026-09-13T14:36:44.587Z"
  },
  {
    "chunk_id": "CHK-DR-005-01",
    "source_id": "SRC-MINSA-005",
    "document_number": "277/20",
    "document_type": "Decreto Presidencial",
    "article_number": "Artigo 15.º",
    "text": "Qualquer reacção adversa grave a medicamentos ocorridos em estabelecimentos públicos ou privados de saúde deve ser notificada à Autoridade Reguladora no prazo improrrogável de 24 horas.",
    "source_sha256": "89c450d16444b97b7ad6efd6a372cced1255e9cc617411d4d20eef0874942d2b",
