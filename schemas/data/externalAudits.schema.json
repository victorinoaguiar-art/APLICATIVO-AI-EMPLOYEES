{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExternalAuditsSchema",
  "type": "object",
  "required": ["$schema", "metadata", "audits"],
  "properties": {
    "$schema": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["version", "scope", "updated_at", "description"],
      "properties": {
        "version": { "type": "string" },
        "scope": { "type": "string" },
        "updated_at": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["audit_id", "auditor_type", "verdict"],
        "properties": {
          "audit_id": { "type": "string" },
          "auditor_type": { "type": "string" },
          "verdict": { "type": "string" },
          "auditor_signature": { "type": "string" },
          "is_internal_receipt": { "type": "boolean" }
        }
      }
    }
  }
}
