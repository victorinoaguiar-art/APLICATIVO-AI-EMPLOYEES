{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PilotOperationalTasksFile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pilot_id",
    "tenant_id",
    "tasks"
  ],
  "properties": {
    "pilot_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{5,64}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{5,64}$"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "pilot_id",
          "tenant_id",
          "employee_id",
          "requested_by",
          "received_at",
          "title",
          "instruction",
          "input_data",
          "idempotency_key",
          "format"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TASK_[A-Za-z0-9_-]{3,64}$"
          },
          "pilot_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{5,64}$"
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{5,64}$"
          },
          "employee_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "requested_by": {
            "type": "string",
            "minLength": 2
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "instruction": {
            "type": "string",
            "minLength": 3
          },
          "input_data": {
            "type": "object"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 5
          },
          "format": {
            "type": "string",
            "enum": [
              "PDF",
              "DOCX",
              "XLSX",
              "JSON"
            ]
          },
          "action_type": {
            "type": "string"
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "OPERATIONAL_PILOT",
              "SIMULATION",
              "DEMO"
            ]
          }
        }
      }
    }
  }
}