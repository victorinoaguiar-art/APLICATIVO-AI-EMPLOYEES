{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LiveSampleExpansionManifestSchema",
  "type": "object",
  "required": ["manifest_status", "reconciliation_note", "summary", "sample_requirements"],
  "additionalProperties": false,
  "properties": {
    "manifest_status": { "type": "string" },
    "reconciliation_note": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["program_version", "total_employees", "sample_totals"],
      "properties": {
        "program_version": { "type": "string" },
        "total_employees": { "type": "integer" },
        "sample_totals": {
          "type": "object",
          "required": ["total_actual_verified_live_tasks"],
          "properties": {
            "total_actual_verified_live_tasks": { "type": "integer", "const": 0 }
          }
        }
      }
    },
    "sample_requirements": {
      "type": "array"
    }
  }
}
